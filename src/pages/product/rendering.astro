---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const post = await getEntry("spec", "product_rendering");
if (!post) { throw new Error("Content not found"); }
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const backUrl = `${base}product/`;
---
<MainGridLayout title={post.data.title} description={post.data.description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-3 relative w-full">
            <a href={backUrl} class="inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition mb-3">
                <Icon name="material-symbols:arrow-back-rounded" class="text-2xl"></Icon>
                <span class="text-sm font-medium">Back</span>
            </a>
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
